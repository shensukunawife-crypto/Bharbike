<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= BRAND_NAME %> Admin — <%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/admin/static/css/style.css?v=4" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      window.__BRAND_NAME__ = "<%= BRAND_NAME %>";
      window.__BRAND_PRODUCT_NAME__ = "<%= BRAND_PRODUCT_NAME %>";
    </script>
    <style>
      /* ─── Chatbot Floating UI ─────────────────────────────── */
      #chatbot-fab {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, #f26d21, #ff8c42);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(242, 109, 33, 0.45);
        z-index: 9999;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      #chatbot-fab:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 16px rgba(242, 109, 33, 0.55);
      }
      #chatbot-window {
        position: fixed;
        bottom: 90px;
        right: 24px;
        width: 340px;
        height: 480px;
        background: #fff;
        border: 1px solid rgba(242, 109, 33, 0.2);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(242,109,33,0.08);
        display: none;
        flex-direction: column;
        z-index: 9998;
        overflow: hidden;
      }
      #chatbot-header {
        background: linear-gradient(135deg, #f26d21, #ff8c42);
        color: #fff;
        padding: 14px 16px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      #chatbot-body {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: #fff;
      }
      .chat-msg {
        max-width: 85%;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 13.5px;
        line-height: 1.4;
        word-break: break-word;
        overflow-wrap: anywhere;
      }
      .chat-msg.user {
        align-self: flex-end;
        background: #f26d21;
        color: #fff;
        border-bottom-right-radius: 2px;
      }
      .chat-msg.bot {
        align-self: flex-start;
        background: #f5f5f5;
        color: #1a1a1a;
        border-bottom-left-radius: 2px;
      }
      .chat-msg.sys {
        align-self: center;
        font-size: 11px;
        color: var(--text-muted);
        text-align: center;
        background: none;
      }
      #chatbot-input-area {
        display: flex;
        padding: 12px;
        border-top: 1px solid var(--border-color);
        background: #fff;
      }
      #chatbot-input {
        flex: 1;
        border: 1px solid var(--border-color);
        background: #f9f9f9;
        color: #1a1a1a;
        border-radius: 20px;
        padding: 8px 14px;
        outline: none;
        font-size: 13.5px;
      }
      #chatbot-send {
        background: #f26d21;
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        margin-left: 8px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s;
      }
      #chatbot-send:hover { opacity: 0.8; }
      /* Markdown formatting inside chat bubbles */
      .chat-msg strong { font-weight: 700; }
      .chat-msg em { font-style: italic; }
      .chat-msg ol, .chat-msg ul { margin: 6px 0 0 16px; padding: 0; }
      .chat-msg li { margin-bottom: 4px; line-height: 1.45; }
      .chat-msg code { background: rgba(0,0,0,0.08); border-radius: 4px; padding: 1px 5px; font-size: 12px; font-family: monospace; }
      .chat-msg p { margin: 0 0 6px 0; }
      .chat-msg p:last-child { margin-bottom: 0; }
      
      /* ─── Notification dropdown ─────────────────────────────── */
      @keyframes pulseRed {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
      }
      @keyframes tickerFade {
        0% { opacity: 0; transform: translateY(5px); }
        10% { opacity: 1; transform: translateY(0); }
        90% { opacity: 1; transform: translateY(0); }
        100% { opacity: 0; transform: translateY(-5px); }
      }

      .topbar-ticker-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
        height: 100%;
        overflow: hidden;
      }
      .topbar-ticker-item {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(99, 102, 241, 0.08);
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid rgba(99, 102, 241, 0.15);
        animation: tickerFade 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
      }

      .notif-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        z-index: 2000;
        width: 360px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        box-shadow: 0 20px 40px -8px rgba(0,0,0,0.15), 0 8px 16px -4px rgba(0,0,0,0.1);
        margin-top: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        animation: notifSlideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes notifSlideIn {
        from { opacity: 0; transform: translateY(-8px) scale(0.96); }
        to   { opacity: 1; transform: translateY(0)   scale(1); }
      }
      
      .dark-mode .notif-dropdown {
        background: rgba(30, 41, 59, 0.85);
        border-color: rgba(255, 255, 255, 0.05);
      }
      
      .notif-dropdown-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px 12px;
        border-bottom: 1px solid var(--border);
      }
      .notif-dropdown-header h3 {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
      }
      .dark-mode .notif-dropdown-header { border-bottom-color: #334155; }

      .notif-action-link {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        text-decoration: none;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(99,102,241,0.1);
        transition: background 0.2s;
      }
      .notif-action-link:hover { background: rgba(99,102,241,0.2); }
      
      .notif-dropdown-list {
        max-height: 420px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }
      .notif-dropdown-list::-webkit-scrollbar { width: 4px; }
      .notif-dropdown-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
      
      .notif-dropdown-item {
        display: flex;
        gap: 12px;
        padding: 11px 16px;
        border-bottom: 1px solid var(--border);
        transition: background 0.14s ease;
        cursor: pointer;
        user-select: none;
      }
      .notif-dropdown-item:last-child { border-bottom: none; }
      .notif-dropdown-item:hover { background: rgba(99,102,241,0.05); }
      .dark-mode .notif-dropdown-item { border-bottom-color: #2d3748; }
      .dark-mode .notif-dropdown-item:hover { background: rgba(255,255,255,0.05); }
      
      .notif-item-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        flex-shrink: 0;
        font-size: 16px;
      }
      
      .notif-item-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
        flex: 1;
      }
      
      .notif-item-title {
        font-weight: 600;
        font-size: 12px;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .notif-item-details {
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.4;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .notif-item-time {
        font-size: 10px;
        color: var(--text-muted);
        opacity: 0.7;
        margin-top: 2px;
      }
      
      .notif-dropdown-footer {
        display: block;
        text-align: center;
        padding: 11px;
        font-size: 12px;
        font-weight: 700;
        color: var(--accent);
        text-decoration: none;
        border-top: 1px solid var(--border);
        transition: background 0.18s;
      }
      .notif-dropdown-footer:hover { background: rgba(99,102,241,0.06); }
      .dark-mode .notif-dropdown-footer { border-top-color: #334155; }

      /* ─── Notification detail modal ─────────────────────────── */
      #notif-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        animation: notifFadeIn 0.18s ease;
      }
      @keyframes notifFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }
      #notif-modal-box {
        background: var(--bg-card, #fff);
        border-radius: 16px;
        box-shadow: 0 30px 60px -12px rgba(0,0,0,0.35);
        width: 100%;
        max-width: 480px;
        overflow: hidden;
        animation: notifModalIn 0.2s cubic-bezier(0.34,1.56,0.64,1);
      }
      @keyframes notifModalIn {
        from { transform: scale(0.88) translateY(20px); opacity: 0; }
        to   { transform: scale(1)    translateY(0);    opacity: 1; }
      }
      .dark-mode #notif-modal-box {
        background: #1e293b;
        border: 1px solid #334155;
      }
      #notif-modal-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 20px 16px;
        border-bottom: 1px solid var(--border);
      }
      .dark-mode #notif-modal-header { border-bottom-color: #334155; }
      #notif-modal-icon-wrap {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
      }
      #notif-modal-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 3px;
      }
      #notif-modal-subtitle {
        font-size: 12px;
        color: var(--text-muted);
        margin: 0;
      }
      #notif-modal-close {
        margin-left: auto;
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-muted);
        padding: 6px;
        border-radius: 8px;
        transition: background 0.15s;
        font-size: 18px;
        line-height: 1;
      }
      #notif-modal-close:hover { background: rgba(0,0,0,0.07); }
      #notif-modal-body {
        padding: 18px 20px 20px;
      }
      .notif-modal-section {
        margin-bottom: 18px;
      }
      .notif-modal-section-title {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 10px;
      }
      .notif-modal-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      .notif-modal-field {
        background: var(--bg-secondary, #f8f9fa);
        border-radius: 10px;
        padding: 10px 12px;
      }
      .dark-mode .notif-modal-field { background: #0f172a; }
      .notif-modal-field-label {
        font-size: 10px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 3px;
      }
      .notif-modal-field-value {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        word-break: break-word;
      }
      .notif-modal-field.full-width {
        grid-column: 1 / -1;
      }
      .notif-modal-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
      }
      .sidebar-badge {
        background-color: #ef4444;
        color: white;
        font-size: 11px;
        font-weight: bold;
        padding: 2px 6px;
        border-radius: 10px;
        margin-left: auto;
        box-shadow: 0 0 4px rgba(239, 68, 68, 0.4);
      }
    </style>
  </head>
  <body>
    <div class="admin-shell">

      <!-- SIDEBAR -->
      <aside class="sidebar" id="admin-sidebar">

        <!-- Logo -->
        <div class="sidebar-logo">
          <div class="logo-mark" style="background: none; border-radius: 0; width: 51px; height: 51px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <img src="/admin/static/images/logo.png" alt="<%= BRAND_NAME %> Logo" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
          <div class="logo-text">
            <span class="logo-name"><%= BRAND_NAME.substring(0,4) %><span class="logo-accent"><%= BRAND_NAME.substring(4) %></span></span>
            <span class="logo-sub">Admin Console</span>
          </div>
        </div>

        <!-- Floating collapse toggle -->
        <button id="sidebar-collapse-btn" class="sidebar-toggle-pill" title="Collapse sidebar" aria-label="Toggle sidebar">
          <svg class="toggle-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <!-- Nav -->
        <nav class="sidebar-nav" id="admin-sidebar-nav">
          <%- include('partials/sidebar-nav') %>
        </nav>

        <!-- User Profile at bottom -->
        <div class="sidebar-user">
          <div class="sidebar-user-avatar">
            <%= (locals.admin && (locals.admin.full_name || locals.admin.email)) ? (locals.admin.full_name || locals.admin.email).charAt(0).toUpperCase() : 'A' %>
          </div>
          <div class="sidebar-user-info">
            <p class="sidebar-user-name"><%= (locals.admin && (locals.admin.full_name || locals.admin.email)) ? (locals.admin.full_name || locals.admin.email) : 'Admin' %></p>
            <p class="sidebar-user-role"><%= (locals.admin && locals.admin.role) ? locals.admin.role.replace(/_/g,' ') : 'master admin' %></p>
          </div>
          <button id="admin-logout-btn" class="sidebar-logout-btn" title="Logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </button>
        </div>

      </aside>

      <!-- MAIN -->
      <div class="main-area">

        <!-- Topbar -->
        <header class="topbar">
          <div class="topbar-left">
            <button class="mobile-menu-btn" id="sidebar-menu-btn" aria-label="Toggle menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
            </button>
            <div>
              <h1 class="topbar-title"><%= title %></h1>
            </div>
          </div>
          
          <div id="topbar-ticker-container" class="topbar-ticker-container" style="display: none;"></div>

          <div class="topbar-right">
            <!-- Speaker Toggle -->
            <button id="speaker-toggle" class="btn btn-primary" title="Toggle AI Voice" style="display: flex; align-items: center; gap: 6px; margin-right: 8px; padding: 6px 14px; font-size: 13.5px; border-radius: 8px;">
              <svg id="icon-speaker-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              </svg>
              <svg id="icon-speaker-off" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none; opacity: 0.8;">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line>
              </svg>
              <span>Bharbot</span>
            </button>
            <!-- Dark Mode Toggle -->
            <button id="theme-toggle" class="icon-btn" title="Toggle dark mode">
              <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
              <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            </button>
            <!-- Notifications Dropdown + Modal -->
            <% 
              const _layoutAdmin = locals.admin || {};
              const _layoutIsMaster = _layoutAdmin.role === 'master_admin' || _layoutAdmin.role === 'admin' || (_layoutAdmin.permissions && _layoutAdmin.permissions.includes('*'));
              const _layoutPerms = Array.isArray(_layoutAdmin.permissions) ? _layoutAdmin.permissions : [];
              const _layoutCanNotif = _layoutIsMaster || _layoutPerms.includes('manage_notifications');
            %>
            <% if (_layoutCanNotif) { %>
            <div class="notif-container" style="position: relative; display: inline-block;">
              <button id="notif-bell-btn" class="icon-btn" title="Recent Activities" style="position: relative;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <span id="notif-badge" style="position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; background: #ef4444; border-radius: 50%; display: none; animation: pulseRed 2s infinite;"></span>
              </button>
              
              <div id="notif-dropdown-panel" class="notif-dropdown" style="display: none;">
                <div class="notif-dropdown-header">
                  <h3>Recent Activity</h3>
                  <a href="/admin/notifications" class="notif-action-link" title="Create Push Notification">Send Push 📣</a>
                </div>
                <div id="notif-dropdown-list" class="notif-dropdown-list">
                  <div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 12px;">Loading activities...</div>
                </div>
                <a href="/admin/activity-logs" target="_blank" class="notif-dropdown-footer">
                  View All Activity Logs &rarr;
                </a>
              </div>
            </div>
            <% } %>
            <!-- Admin Info -->
            <% if (locals.admin) { %>
            <div class="topbar-admin">
              <div class="topbar-admin-avatar">
                <%= (locals.admin.full_name || locals.admin.email || 'A').charAt(0).toUpperCase() %>
              </div>
              <div class="topbar-admin-info">
                <span class="topbar-admin-name"><%= locals.admin.full_name || locals.admin.email %></span>
                <span class="topbar-admin-role"><%= (locals.admin.role || 'admin').replace(/_/g,' ') %></span>
              </div>
            </div>
            <% } %>
          </div>
        </header>

        <!-- Page Content -->
        <main class="page-content">
          <% if (locals.isServiceRoleConfigured === false) { %>
            <div class="rls-warning-banner" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 16px; color: var(--text);">
              <div style="background: #dc2626; color: white; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 800; font-size: 18px; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);">⚠️</div>
              <div style="flex: 1;">
                <h4 style="margin: 0 0 4px 0; font-size: 14.5px; font-weight: 700; color: var(--text);">Restricted Database Key Mode (RLS Active)</h4>
                <p style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.45;">
                  The backend server is running with the public anonymous key (Subject to Row Level Security) because the <strong>SUPABASE_SERVICE_ROLE_KEY</strong> environment variable is missing. Due to RLS policies, public SELECT queries on the <code>users</code> table are filtered, resulting in <strong>0 users</strong> being displayed on the dashboard and users page.
                </p>
                <div style="margin-top: 10px; display: flex; gap: 12px; align-items: center;">
                  <span style="font-size: 11.5px; font-weight: 700; color: #ef4444; text-transform: uppercase; letter-spacing: 0.05em;"><%= locals.isProduction ? 'Action Required: Configure Render' : 'Action Required: Local .env File' %></span>
                  <a href="#diagnostics-help" onclick="alert('How to Fix This:\n\n1. PRODUCTION (Render):\nGo to Render Dashboard -> bharbike-backend -> Environment. Add a new variable:\n- Key: SUPABASE_SERVICE_ROLE_KEY\n- Value: (Your Supabase service_role secret key from Project Settings -> API)\n\n2. LOCAL DEVELOPMENT:\nAdd SUPABASE_SERVICE_ROLE_KEY to your bike rental system backend/.env file and restart the npm server.')" style="font-size: 12.5px; font-weight: 700; color: var(--text); text-decoration: underline;">How to Fix This</a>
                </div>
              </div>
            </div>
          <% } %>
          <%- include(bodyView) %>
        </main>

      </div>
    </div>

    <div id="toast-container" class="toast-container"></div>

    <script>
      (() => {
        // Auth check
        const token = localStorage.getItem("adminToken");
        if (!token) { window.location.href = "/admin/login"; return; }

        // Logout
        const logoutBtn = document.getElementById("admin-logout-btn");
        if (logoutBtn) {
          logoutBtn.addEventListener("click", () => {
            localStorage.removeItem("adminToken");
            document.cookie = "admin_token=; Path=/; Max-Age=0; SameSite=Lax";
            window.location.href = "/admin/login";
          });
        }

        // Dark mode
        const themeToggle = document.getElementById("theme-toggle");
        const iconMoon = document.getElementById("icon-moon");
        const iconSun = document.getElementById("icon-sun");
        const applyTheme = (dark) => {
          document.body.classList.toggle("dark-mode", dark);
          if (iconMoon) iconMoon.style.display = dark ? "none" : "block";
          if (iconSun) iconSun.style.display = dark ? "block" : "none";
        };
        applyTheme(localStorage.getItem("adminTheme") === "dark");
        if (themeToggle) {
          themeToggle.addEventListener("click", () => {
            const isDark = document.body.classList.toggle("dark-mode");
            localStorage.setItem("adminTheme", isDark ? "dark" : "light");
            applyTheme(isDark);
          });
        }

        // Mobile sidebar
        const menuBtn = document.getElementById("sidebar-menu-btn");
        const sidebar = document.getElementById("admin-sidebar");
        if (menuBtn && sidebar) {
          menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
        }

        // Sidebar collapse (desktop)
        const collapseBtn = document.getElementById("sidebar-collapse-btn");
        const shell = document.querySelector(".admin-shell");
        const applyCollapse = (collapsed) => {
          if (sidebar) sidebar.classList.toggle("sidebar-collapsed", collapsed);
          if (shell) shell.classList.toggle("sidebar-is-collapsed", collapsed);
          const arrow = collapseBtn ? collapseBtn.querySelector(".toggle-arrow") : null;
          if (arrow) arrow.style.transform = collapsed ? "rotate(180deg)" : "rotate(0deg)";
          if (collapseBtn) collapseBtn.title = collapsed ? "Expand sidebar" : "Collapse sidebar";
        };
        const savedCollapse = localStorage.getItem("adminSidebarCollapsed") === "true";
        applyCollapse(savedCollapse);
        if (collapseBtn) {
          collapseBtn.addEventListener("click", () => {
            const next = !sidebar.classList.contains("sidebar-collapsed");
            applyCollapse(next);
            localStorage.setItem("adminSidebarCollapsed", next ? "true" : "false");
          });
        }

        // ─── Topbar Notifications Dropdown + Detail Modal ───
        const notifBtn    = document.getElementById("notif-bell-btn");
        const notifPanel  = document.getElementById("notif-dropdown-panel");
        const notifList   = document.getElementById("notif-dropdown-list");
        const notifBadge  = document.getElementById("notif-badge");
        // NOTE: modal elements are looked up lazily (they live after this script tag)

        // ── Helpers ──────────────────────────────────────────────
        const timeAgo = (ds) => {
          if (!ds) return "";
          const date = new Date(ds);
          const now  = new Date();
          const s    = Math.floor((now - date) / 1000);
          if (s < 60)   return "just now";
          const m = Math.floor(s / 60);
          if (m < 60)   return m + " min ago";
          const h = Math.floor(m / 60);
          if (h < 24)   return h + " hr" + (h > 1 ? "s" : "") + " ago";
          // Check if yesterday
          const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
          const daysDiff   = Math.floor((todayStart - new Date(date.getFullYear(), date.getMonth(), date.getDate())) / 86400000);
          if (daysDiff === 1) return "Yesterday";
          if (daysDiff < 7)  return daysDiff + " days ago";
          // Older — show actual date
          return date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: daysDiff > 365 ? "numeric" : undefined });
        };

        const fmtDate = (ds) => {
          if (!ds || ds === "N/A") return "—";
          try {
            return new Date(ds).toLocaleString("en-IN", {
              day: "2-digit", month: "short", year: "numeric",
              hour: "2-digit", minute: "2-digit", hour12: true
            });
          } catch { return ds; }
        };

        const ICONS = {
          order:        { char: "🚲", bg: "rgba(99,102,241,0.15)",  color: "#6366f1" },
          booking:      { char: "🔑", bg: "rgba(16,185,129,0.15)",  color: "#10b981" },
          payment:      { char: "💰", bg: "rgba(245,158,11,0.15)",  color: "#f59e0b" },
          kyc:          { char: "🛡️", bg: "rgba(239,68,68,0.15)",   color: "#ef4444" },
          subscription: { char: "⚡", bg: "rgba(139,92,246,0.15)",  color: "#8b5cf6" },
          support:      { char: "💬", bg: "rgba(59,130,246,0.15)",  color: "#3b82f6" },
          maintenance:  { char: "🛠️", bg: "rgba(249,115,22,0.15)",  color: "#f97316" },
          user:         { char: "👋", bg: "rgba(236,72,153,0.15)",  color: "#ec4899" },
          default:      { char: "🔔", bg: "rgba(156,163,175,0.15)", color: "#9ca3af" }
        };
        const getIcon = (t) => ICONS[t] || ICONS.default;

        const esc = (s) => s == null ? "" : String(s)
          .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
          .replace(/"/g,"&quot;").replace(/'/g,"&#039;");

        const field = (label, value, full) =>
          `<div class="notif-modal-field${full ? " full-width" : ""}">
             <div class="notif-modal-field-label">${esc(label)}</div>
             <div class="notif-modal-field-value">${esc(value || "—")}</div>
           </div>`;

        // ── Build modal body ──────────────────────────────────────
        const buildModalBody = (log) => {
          const r = log.raw || {};
          let eventFields = "";
          if (log.type === "order") {
            eventFields = field("Amount", r.amount) + field("Status", r.status);
          } else if (log.type === "booking") {
            eventFields = field("Bike ID", r.bike_id) + field("Status", r.status)
              + (r.amount && r.amount !== "N/A" ? field("Rental Price", r.amount) : "");
          } else if (log.type === "payment") {
            eventFields = field("Transaction Type", r.tx_type) + field("Amount", r.amount)
              + field("Status", r.status) + field("Description", r.description, true);
          } else if (log.type === "kyc") {
            eventFields = field("Document Type", r.doc_type) + field("Status", r.status);
          } else if (log.type === "subscription") {
            eventFields = field("Plan", r.plan) + field("Status", r.status)
              + field("Start Date", fmtDate(r.start_date)) + field("End Date", fmtDate(r.end_date));
          } else if (log.type === "support") {
            eventFields = field("Issue", r.issue) + field("Status", r.status);
          } else if (log.type === "maintenance") {
            eventFields = field("Bike Code", r.bike) + field("Issue", r.issue) + field("Status", r.status);
          } else if (log.type === "user") {
            eventFields = field("Phone", r.phone) + field("Email", r.email, true);
          }
          return `
            <div class="notif-modal-section">
              <div class="notif-modal-section-title">Rider Information</div>
              <div class="notif-modal-grid">
                ${field("Name", log.user_name)}
                ${field("Phone", log.user_phone)}
                ${log.user_email ? field("Email", log.user_email, true) : ""}
              </div>
            </div>
            <div class="notif-modal-section">
              <div class="notif-modal-section-title">Event Details</div>
              <div class="notif-modal-grid">
                ${eventFields}
                ${field("Date & Time", fmtDate(log.timestamp), true)}
              </div>
            </div>`;
        };

        // ── Modal open / close (lazy element lookup) ──────────────
        const closeModal = () => {
          const ov = document.getElementById("notif-modal-overlay");
          if (ov) ov.style.display = "none";
          document.body.style.overflow = "";
        };

        const openModal = (log) => {
          const ov      = document.getElementById("notif-modal-overlay");
          const iconWrap = document.getElementById("notif-modal-icon-wrap");
          const titleEl  = document.getElementById("notif-modal-title");
          const subEl    = document.getElementById("notif-modal-subtitle");
          const bodyEl   = document.getElementById("notif-modal-body");
          if (!ov || !iconWrap || !titleEl || !subEl || !bodyEl) {
            console.warn("[notif] modal elements not found in DOM");
            return;
          }
          const icon = getIcon(log.type);
          iconWrap.textContent = icon.char;
          iconWrap.style.cssText =
            `background:${icon.bg};color:${icon.color};width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;`;
          titleEl.textContent = log.action;
          subEl.textContent   = log.user_name + (log.user_phone ? " · " + log.user_phone : "");
          bodyEl.innerHTML    = buildModalBody(log);
          ov.style.display    = "flex";
          document.body.style.overflow = "hidden";
          if (notifPanel) notifPanel.style.display = "none";
        };

        // Delegated close handlers (work even though modal HTML comes after script)
        document.addEventListener("click", (e) => {
          const ov = document.getElementById("notif-modal-overlay");
          if (!ov || ov.style.display === "none") return;
          if (e.target === ov || e.target.id === "notif-modal-close") closeModal();
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeModal(); });


        // ── Render dropdown list ──────────────────────────────────
        let allLogs = [];

        const renderList = () => {
          if (!notifList) return;
          if (allLogs.length === 0) {
            notifList.innerHTML = `<div style="padding:28px;text-align:center;color:var(--text-muted);font-size:12px;">No recent activities</div>`;
            return;
          }
          notifList.innerHTML = allLogs.slice(0, 15).map((log, idx) => {
            const icon = getIcon(log.type);
            return `<div class="notif-dropdown-item" data-idx="${idx}" style="cursor:pointer;">
              <div class="notif-item-icon" style="background:${icon.bg};color:${icon.color};">${icon.char}</div>
              <div class="notif-item-content">
                <div class="notif-item-title">${esc(log.user_name)}: ${esc(log.action)}</div>
                <div class="notif-item-details">${esc(log.details)}</div>
                <div class="notif-item-time">${timeAgo(log.timestamp)}</div>
              </div>
              <svg style="flex-shrink:0;opacity:0.3;align-self:center;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </div>`;
          }).join("");

          // Bind click on each item → open modal
          notifList.querySelectorAll(".notif-dropdown-item").forEach((el) => {
            el.addEventListener("click", () => {
              const log = allLogs[parseInt(el.dataset.idx, 10)];
              if (log) openModal(log);
            });
          });
        };

        // ── Voice Assistant Logic ─────────────────────────────────
        let lastSpokenTimestamp = parseInt(localStorage.getItem("adminLastSpokenTimestamp")) || Date.now();

        const speakText = (text) => {
            const isEnabled = localStorage.getItem("adminVoiceEnabled") === "true";
            if (!isEnabled || !window.speechSynthesis) return;

            const volume = parseFloat(localStorage.getItem("adminVoiceVolume")) || 1;
            const rate = parseFloat(localStorage.getItem("adminVoiceRate")) || 1;
            const pitch = parseFloat(localStorage.getItem("adminVoicePitch")) || 1;
            const voiceURI = localStorage.getItem("adminVoiceURI");

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.volume = volume;
            utterance.rate = rate;
            utterance.pitch = pitch;

            if (voiceURI) {
                const voices = window.speechSynthesis.getVoices();
                const selectedVoice = voices.find(v => v.voiceURI === voiceURI);
                if (selectedVoice) utterance.voice = selectedVoice;
            }
            window.speechSynthesis.speak(utterance);
        };

        // ── Fetch activities ──────────────────────────────────────
        const fetchActivities = async () => {
          try {
            const res = await fetch("/admin/activity-logs?ajax=true");
            if (!res.ok) throw new Error("fetch failed");
            const data = await res.json();
            if (data && data.success && Array.isArray(data.logs)) {
              allLogs = data.logs;
              window.allLogs = data.logs; // Expose globally for TTS and Chatbot
              renderList();
              
              // --- VOICE ASSISTANT TRIGGER ---
              if (localStorage.getItem("adminVoiceEnabled") === "true" && allLogs.length > 0) {
                  const newLogsToSpeak = allLogs.filter(log => new Date(log.timestamp).getTime() > lastSpokenTimestamp);
                  if (newLogsToSpeak.length > 0) {
                      newLogsToSpeak.sort((a,b) => new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime());
                      newLogsToSpeak.forEach(log => {
                          let msg = "";
                          const name = log.user_name || "Someone";
                          switch(log.type) {
                            case "subscription": msg = `Awesome! ${name} just subscribed to a plan.`; break;
                            case "support": msg = `Attention needed: ${name} just submitted a new support ticket.`; break;
                            case "order": msg = `Great news, ${name} has just placed a new rental order.`; break;
                            case "booking": msg = `Great news, ${name} has just booked a ride.`; break;
                            case "kyc": msg = `Hey, ${name} has just uploaded their KYC documents for verification.`; break;
                            case "payment": msg = `Cha-ching! A new payment has been successfully received from ${name}.`; break;
                            case "maintenance": msg = `Alert: A bike has been reported for maintenance.`; break;
                            case "user": msg = `We have a new rider! ${name} has just registered an account.`; break;
                            default: msg = `New notification from ${name}.`;
                          }
                          speakText(msg);
                      });
                      lastSpokenTimestamp = new Date(newLogsToSpeak[newLogsToSpeak.length - 1].timestamp).getTime();
                      localStorage.setItem("adminLastSpokenTimestamp", lastSpokenTimestamp);
                  }
              }
              if (allLogs.length > 0 && notifBadge) notifBadge.style.display = "block";

              // --- SIDEBAR BADGES LOGIC ---
              const currentPath = window.location.pathname;
              let lastViewed = JSON.parse(localStorage.getItem('adminLastViewed') || '{}');
              
              const pathToType = {
                '/admin/orders': 'order',
                '/admin/bookings': 'booking',
                '/admin/payments': 'payment',
                '/admin/kyc-documents': 'kyc',
                '/admin/subscriptions': 'subscription',
                '/admin/support': 'support',
                '/admin/maintenance': 'maintenance',
                '/admin/users': 'user'
              };
              
              if (pathToType[currentPath]) {
                lastViewed[pathToType[currentPath]] = Date.now();
                localStorage.setItem('adminLastViewed', JSON.stringify(lastViewed));
              }
              
              const typeCounts = {};
              const oneDayAgo = Date.now() - 24 * 60 * 60 * 1000;
              allLogs.forEach(log => {
                const logTime = new Date(log.timestamp).getTime();
                if (logTime > oneDayAgo && logTime > (lastViewed[log.type] || 0)) {
                  typeCounts[log.type] = (typeCounts[log.type] || 0) + 1;
                }
              });
              
              Object.values(pathToType).forEach(type => {
                const badgeEl = document.getElementById('badge-' + type);
                if (badgeEl) {
                  if (typeCounts[type] > 0) {
                    badgeEl.textContent = typeCounts[type];
                    badgeEl.style.display = 'inline-block';
                  } else {
                    badgeEl.style.display = 'none';
                  }
                }
              });
              // ----------------------------
              startTicker();
            }
          } catch (err) {
            console.warn("[notif] fetch error:", err);
          }
        };

        // ── Ticker Logic ──────────────────────────────────────────
        let tickerTimer = null;
        const startTicker = () => {
          const tickerContainer = document.getElementById("topbar-ticker-container");
          if (!tickerContainer || allLogs.length === 0) return;
          
          tickerContainer.style.display = "flex";
          let currentTickerIdx = 0;
          
          const topLogs = allLogs.slice(0, 5);
          
          const renderCurrentTicker = () => {
            const log = topLogs[currentTickerIdx];
            const icon = getIcon(log.type);
            tickerContainer.innerHTML = `<div class="topbar-ticker-item" style="cursor:pointer;">
              <span style="font-size:16px;">${icon.char}</span>
              <span><strong>${esc(log.user_name)}</strong> ${esc(log.action)} <span style="opacity:0.6;font-size:11.5px;margin-left:4px;">· ${timeAgo(log.timestamp)}</span></span>
            </div>`;
            tickerContainer.firstElementChild.addEventListener("click", () => openModal(log));
            currentTickerIdx = (currentTickerIdx + 1) % topLogs.length;
          };
          
          if (tickerTimer) clearInterval(tickerTimer);
          renderCurrentTicker();
          tickerTimer = setInterval(renderCurrentTicker, 4000);
        };

        // ── Bell button toggle ────────────────────────────────────
        if (notifBtn && notifPanel) {
          notifBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const visible = notifPanel.style.display === "block";
            if (visible) {
              notifPanel.style.display = "none";
            } else {
              notifPanel.style.display = "block";
              if (notifBadge) notifBadge.style.display = "none";
              if (allLogs.length === 0) fetchActivities();
            }
          });

          document.addEventListener("click", (e) => {
            if (!notifPanel.contains(e.target) && !notifBtn.contains(e.target)) {
              notifPanel.style.display = "none";
            }
          });

          // Initial silent fetch to arm the badge
          fetchActivities();
          setInterval(fetchActivities, 60000);
        }
      })();
    </script>
    <script src="/admin/static/js/sidebar-nav.js?v=3"></script>
    <script src="/admin/static/js/admin.js?v=3"></script>

    <!-- Notification detail modal (global, rendered once) -->
    <div id="notif-modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="notif-modal-title">
      <div id="notif-modal-box">
        <div id="notif-modal-header">
