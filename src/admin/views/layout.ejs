    <!-- ── Floating Chatbot ── -->
    <div id="chatbot-fab">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </div>
    <div id="chatbot-window">
      <div id="chatbot-header">
        <div style="display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 1 0 10 10H12z"/><path d="M12 12 2.1 7.1"/>
          </svg>
          BharBot
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <button id="chatbot-clear" title="Clear chat" style="background: rgba(255,255,255,0.2); border: none; color: #fff; cursor: pointer; border-radius: 6px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.35)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4h6v2"></path></svg>
          </button>
          <button id="chatbot-close" title="Close" style="background: rgba(255,255,255,0.2); border: none; color: #fff; cursor: pointer; border-radius: 6px; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; font-size: 18px; line-height:1; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.35)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">&times;</button>
        </div>
      </div>
      <div id="chatbot-body">
        <div class="chat-msg bot" style="background: rgba(242,109,33,0.1); color: #c45510; font-weight:500;">👋 Hi! I'm your BharBike AI Assistant. Ask me anything about your platform — bookings, revenue, users, bikes, or recent activity!</div>
      </div>
      <form id="chatbot-input-area">
        <input type="text" id="chatbot-input" placeholder="Ask about recent data..." autocomplete="off" />
        <button type="submit" id="chatbot-send">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </div>

    <script>
      // ── Chatbot Logic ─────────────────────────────────────────
      document.addEventListener("DOMContentLoaded", () => {
        const fab = document.getElementById("chatbot-fab");
        const chatWin = document.getElementById("chatbot-window");
        const closeBtn = document.getElementById("chatbot-close");
        const chatBody = document.getElementById("chatbot-body");
        const chatForm = document.getElementById("chatbot-input-area");
        const chatInput = document.getElementById("chatbot-input");

        // Load History
        let chatHistory = JSON.parse(localStorage.getItem("adminChatHistory") || "[]");

        const WELCOME = '<div class="chat-msg bot" style="background:rgba(242,109,33,0.1);color:#c45510;font-weight:500;">👋 Hi! I\'m your BharBike AI Assistant. Ask me anything about your platform — bookings, revenue, users, bikes, or recent activity!</div>';

        // Simple markdown → HTML parser
        const parseMarkdown = (text) => {
          const lines = text.split('\n');
          let html = '';
          let inOl = false, inUl = false;

          const closeList = () => {
            if (inOl) { html += '</ol>'; inOl = false; }
            if (inUl) { html += '</ul>'; inUl = false; }
          };

          lines.forEach(line => {
            // Ordered list: "1. ", "2. " etc
            const olMatch = line.match(/^\s*\d+\.\s+(.+)/);
            // Unordered list: "- ", "* ", "• "
            const ulMatch = line.match(/^\s*[-*•]\s+(.+)/);

            if (olMatch) {
              if (inUl) { html += '</ul>'; inUl = false; }
              if (!inOl) { html += '<ol>'; inOl = true; }
              html += `<li>${formatInline(olMatch[1])}</li>`;
            } else if (ulMatch) {
              if (inOl) { html += '</ol>'; inOl = false; }
              if (!inUl) { html += '<ul>'; inUl = true; }
              html += `<li>${formatInline(ulMatch[1])}</li>`;
            } else {
              closeList();
              if (line.trim() === '') {
                html += '<br>';
              } else {
                html += `<p>${formatInline(line)}</p>`;
              }
            }
          });
          closeList();
          return html;
        };

        const formatInline = (text) => {
          return text
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.+?)\*/g, '<em>$1</em>')
            .replace(/`(.+?)`/g, '<code>$1</code>');
        };

        const renderHistory = () => {
          chatBody.innerHTML = WELCOME;
          chatHistory.forEach(msg => {
            const div = document.createElement("div");
            div.className = `chat-msg ${msg.role === "user" ? "user" : "bot"}`;
            if (msg.role === "user") {
              div.textContent = msg.content;
            } else {
              div.innerHTML = parseMarkdown(msg.content);
            }
            chatBody.appendChild(div);
          });
          chatBody.scrollTop = chatBody.scrollHeight;
        };
        renderHistory();

        // Toggle UI
        fab.addEventListener("click", () => {
          chatWin.style.display = chatWin.style.display === "flex" ? "none" : "flex";
          if (chatWin.style.display === "flex") {
            chatInput.focus();
            chatBody.scrollTop = chatBody.scrollHeight;
          }
        });
        closeBtn.addEventListener("click", () => { chatWin.style.display = "none"; });
        document.getElementById("chatbot-clear").addEventListener("click", () => {
          if (confirm("Clear all chat history?")) {
            chatHistory = [];
            localStorage.removeItem("adminChatHistory");
            renderHistory();
          }
        });

        // Handle Submit
        chatForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const text = chatInput.value.trim();
          if (!text) return;

          // Add User msg
          chatHistory.push({ role: "user", content: text });
          renderHistory();
          chatInput.value = "";

          // Add temporary loading indicator
          const loadDiv = document.createElement("div");
          loadDiv.className = "chat-msg bot";
          loadDiv.textContent = "Thinking...";
          loadDiv.id = "chat-loader";
          loadDiv.style.fontStyle = "italic";
          loadDiv.style.opacity = "0.7";
          chatBody.appendChild(loadDiv);
          chatBody.scrollTop = chatBody.scrollHeight;
          
          const loadingMessages = ["Thinking...", "Looking up data...", "Pulling records...", "Analyzing..."];
          let loaderIndex = 0;
          const loaderInterval = setInterval(() => {
            loaderIndex = (loaderIndex + 1) % loadingMessages.length;
            const el = document.getElementById("chat-loader");
            if (el) el.textContent = loadingMessages[loaderIndex];
          }, 1500);

          try {
            // Only send the last 6 messages so the payload doesn't become massively slow over time
            const recentHistory = chatHistory.slice(-6);
            
            const res = await fetch("/admin/chatbot", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                messages: recentHistory
              })
            });
            const data = await res.json();
            
            clearInterval(loaderInterval);
            document.getElementById("chat-loader").remove();
            
            if (data.success) {
              chatHistory.push({ role: "assistant", content: data.reply });
              speakText(data.reply);
            } else {
              chatHistory.push({ role: "assistant", content: "Error: " + data.message });
            }
          } catch (err) {
            clearInterval(loaderInterval);
            document.getElementById("chat-loader").remove();
            chatHistory.push({ role: "assistant", content: "Network error. Could not reach AI." });
          }
          
          // Save and render
          localStorage.setItem("adminChatHistory", JSON.stringify(chatHistory));
          renderHistory();
        });

        // ── Text-to-Speech Helper ─────────────────────────────────
        if ("speechSynthesis" in window) {
          // Pre-load voices for Chrome which loads them asynchronously
          window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
        }

        function speakText(text) {
          if (!("speechSynthesis" in window)) return;
          if (localStorage.getItem("adminSpeakerMuted") === "true") return;
          
          window.speechSynthesis.cancel(); // Stop current speech before starting new
          
          // Strip markdown and emojis for speech
          const cleanText = text.replace(/[*#_`]/g, '').replace(/\n/g, ' ').trim();
          if (!cleanText) return;

          const utterance = new SpeechSynthesisUtterance(cleanText);
          utterance.rate = 0.9; // Slowed down slightly
          utterance.pitch = 1.1;
          utterance.volume = 1.0; // Max volume

          // Try to find a female voice
          const voices = window.speechSynthesis.getVoices();
          const femaleVoice = voices.find(v => 
            v.name.includes('Female') || 
            v.name.includes('Zira') || 
            v.name.includes('Samantha') || 
            v.name.includes('Victoria') ||
            (v.name.includes('Google') && v.name.includes('English') && !v.name.includes('Male'))
          );
          
          if (femaleVoice) {
            utterance.voice = femaleVoice;
          }

          window.speechSynthesis.speak(utterance);
        }

        // Speaker Toggle Logic
        const speakerToggle = document.getElementById("speaker-toggle");
        const iconSpeakerOn = document.getElementById("icon-speaker-on");
        const iconSpeakerOff = document.getElementById("icon-speaker-off");
        
        const applySpeakerTheme = (muted) => {
          if (iconSpeakerOn) iconSpeakerOn.style.display = muted ? "none" : "block";
          if (iconSpeakerOff) iconSpeakerOff.style.display = muted ? "block" : "none";
          if (muted && "speechSynthesis" in window) window.speechSynthesis.cancel();
        };
        
        applySpeakerTheme(localStorage.getItem("adminSpeakerMuted") === "true");
        
        if (speakerToggle) {
          speakerToggle.addEventListener("click", () => {
            const isMuted = localStorage.getItem("adminSpeakerMuted") === "true";
            localStorage.setItem("adminSpeakerMuted", isMuted ? "false" : "true");
            applySpeakerTheme(!isMuted);
          });
        }

        // Welcome greeting on first interaction (required by browser policies)
        let hasWelcomed = false;
        document.body.addEventListener("click", () => {
          if (!hasWelcomed) {
            let speechText = "Welcome to Bhar Bike. ";
            if (window.allLogs && window.allLogs.length > 0) {
              const tenHoursAgo = new Date(Date.now() - 10 * 60 * 60 * 1000);
              const recent = window.allLogs.filter(log => new Date(log.timestamp) > tenHoursAgo);
              if (recent.length > 0) {
                speechText += `You have ${recent.length} notifications from the last 10 hours. `;
                const toRead = recent.slice(0, 3);
                toRead.forEach((log, idx) => {
                  let msg = log.message || log.title || "";
                  if (!msg) {
                    const name = log.user_name || "Someone";
                    switch(log.type) {
                      case "subscription": msg = `${name} subscribed.`; break;
                      case "support": msg = `${name} submitted a ticket.`; break;
                      case "order": msg = `${name} placed an order.`; break;
                      case "booking": msg = `${name} booked a ride.`; break;
                      case "kyc": msg = `${name} uploaded KYC.`; break;
                      case "payment": msg = `Payment received from ${name}.`; break;
                      case "maintenance": msg = `Bike reported for maintenance.`; break;
                      case "user": msg = `New user ${name} registered.`; break;
                      default: msg = `New ${log.type} activity.`;
                    }
                  }
                  speechText += `Notification ${idx + 1}: ${msg} `;
                });
                if (recent.length > 3) speechText += `And ${recent.length - 3} more.`;
              } else {
                speechText += "You have no new notifications in the last 10 hours.";
              }
            } else {
              speechText += "You have no new notifications in the last 10 hours.";
            }
            speakText(speechText);
            hasWelcomed = true;
          }
        }, { once: true });
        
      });
    </script>
  </body>
</html>
