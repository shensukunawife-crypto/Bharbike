<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= BRAND_NAME %> Admin — <%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/admin/static/css/style.css?v=3" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      window.__BRAND_NAME__ = "<%= BRAND_NAME %>";
      window.__BRAND_PRODUCT_NAME__ = "<%= BRAND_PRODUCT_NAME %>";
    </script>
    <style>
      /* Notifications topbar dropdown styling */
      .notif-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        z-index: 2000;
        width: 320px;
        background: var(--bg-card, #ffffff);
        border: 1px solid var(--border);
        border-radius: var(--radius-md, 0.75rem);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        margin-top: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      
      [data-theme="dark"] .notif-dropdown,
      .dark-mode .notif-dropdown {
        background: #1e293b !important;
        border-color: #334155 !important;
      }
      
      .notif-dropdown-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: rgba(0,0,0,0.02);
      }
      
      [data-theme="dark"] .notif-dropdown-header,
      .dark-mode .notif-dropdown-header {
        background: rgba(255,255,255,0.02) !important;
        border-bottom-color: #334155 !important;
      }

      .notif-action-link {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .notif-action-link:hover {
        opacity: 0.8;
      }
      
      .notif-dropdown-list {
        max-height: 280px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
      }
      
      .notif-dropdown-item {
        display: flex;
        gap: 12px;
        padding: 12px 16px;
        text-decoration: none;
        color: inherit;
        border-bottom: 1px solid var(--border);
        transition: background 0.15s ease;
      }
      
      .notif-dropdown-item:hover {
        background: rgba(0,0,0,0.02);
      }
      
      [data-theme="dark"] .notif-dropdown-item,
      .dark-mode .notif-dropdown-item {
        border-bottom-color: #334155 !important;
      }
      
      [data-theme="dark"] .notif-dropdown-item:hover,
      .dark-mode .notif-dropdown-item:hover {
        background: rgba(255,255,255,0.05) !important;
      }
      
      .notif-item-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        flex-shrink: 0;
        font-size: 13px;
      }
      
      .notif-item-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        overflow: hidden;
      }
      
      .notif-item-title {
        font-weight: 600;
        font-size: 11.5px;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .notif-item-details {
        font-size: 10.5px;
        color: var(--text-muted);
        line-height: 1.3;
      }
      
      .notif-item-time {
        font-size: 9.5px;
        color: var(--text-muted);
        opacity: 0.8;
        margin-top: 2px;
      }
      
      .notif-dropdown-footer {
        display: block;
        text-align: center;
        padding: 10px;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--accent);
        text-decoration: none;
        border-top: 1px solid var(--border);
        background: rgba(0,0,0,0.01);
        transition: background 0.2s;
      }
      .notif-dropdown-footer:hover {
        background: rgba(0,0,0,0.03);
      }
      [data-theme="dark"] .notif-dropdown-footer,
      .dark-mode .notif-dropdown-footer {
        border-top-color: #334155 !important;
        background: rgba(255,255,255,0.01) !important;
      }
      [data-theme="dark"] .notif-dropdown-footer:hover,
      .dark-mode .notif-dropdown-footer:hover {
        background: rgba(255,255,255,0.03) !important;
      }
    </style>
  </head>
  <body>
    <div class="admin-shell">

      <!-- SIDEBAR -->
      <aside class="sidebar" id="admin-sidebar">

        <!-- Logo -->
        <div class="sidebar-logo">
          <div class="logo-mark" style="background: none; border-radius: 0; width: 51px; height: 51px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            <img src="/admin/static/images/logo.png" alt="<%= BRAND_NAME %> Logo" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
          <div class="logo-text">
            <span class="logo-name"><%= BRAND_NAME.substring(0,4) %><span class="logo-accent"><%= BRAND_NAME.substring(4) %></span></span>
            <span class="logo-sub">Admin Console</span>
          </div>
        </div>

        <!-- Floating collapse toggle -->
        <button id="sidebar-collapse-btn" class="sidebar-toggle-pill" title="Collapse sidebar" aria-label="Toggle sidebar">
          <svg class="toggle-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <!-- Nav -->
        <nav class="sidebar-nav" id="admin-sidebar-nav">
          <%- include('partials/sidebar-nav') %>
        </nav>

        <!-- User Profile at bottom -->
        <div class="sidebar-user">
          <div class="sidebar-user-avatar">
            <%= (locals.admin && (locals.admin.full_name || locals.admin.email)) ? (locals.admin.full_name || locals.admin.email).charAt(0).toUpperCase() : 'A' %>
          </div>
          <div class="sidebar-user-info">
            <p class="sidebar-user-name"><%= (locals.admin && (locals.admin.full_name || locals.admin.email)) ? (locals.admin.full_name || locals.admin.email) : 'Admin' %></p>
            <p class="sidebar-user-role"><%= (locals.admin && locals.admin.role) ? locals.admin.role.replace(/_/g,' ') : 'master admin' %></p>
          </div>
          <button id="admin-logout-btn" class="sidebar-logout-btn" title="Logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </button>
        </div>

      </aside>

      <!-- MAIN -->
      <div class="main-area">

        <!-- Topbar -->
        <header class="topbar">
          <div class="topbar-left">
            <button class="mobile-menu-btn" id="sidebar-menu-btn" aria-label="Toggle menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
            </button>
            <div>
              <h1 class="topbar-title"><%= title %></h1>
            </div>
          </div>
          <div class="topbar-right">
            <!-- Dark Mode Toggle -->
            <button id="theme-toggle" class="icon-btn" title="Toggle dark mode">
              <svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
              <svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            </button>
            <!-- Notifications Dropdown -->
            <% 
              const _layoutAdmin = locals.admin || {};
              const _layoutIsMaster = _layoutAdmin.role === 'master_admin' || _layoutAdmin.role === 'admin' || (_layoutAdmin.permissions && _layoutAdmin.permissions.includes('*'));
              const _layoutPerms = Array.isArray(_layoutAdmin.permissions) ? _layoutAdmin.permissions : [];
              const _layoutCanNotif = _layoutIsMaster || _layoutPerms.includes('manage_notifications');
            %>
            <% if (_layoutCanNotif) { %>
            <div class="notif-container" style="position: relative; display: inline-block;">
              <button id="notif-bell-btn" class="icon-btn" title="Recent Activities" style="position: relative;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
                <span id="notif-badge" style="position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; background: #ef4444; border-radius: 50%; display: none;"></span>
              </button>
              
              <div id="notif-dropdown-panel" class="notif-dropdown" style="display: none;">
                <div class="notif-dropdown-header">
                  <span style="font-weight: 700; font-size: 13px;">Recent Updates</span>
                  <a href="/admin/notifications" class="notif-action-link" title="Create Push Notification">Send Push 📣</a>
                </div>
                <div id="notif-dropdown-list" class="notif-dropdown-list">
                  <div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 12px;">Loading activities...</div>
                </div>
                <a href="/admin/activity-logs" class="notif-dropdown-footer">
                  View All Activity Logs &rarr;
                </a>
              </div>
            </div>
            <% } %>
            <!-- Admin Info -->
            <% if (locals.admin) { %>
            <div class="topbar-admin">
              <div class="topbar-admin-avatar">
                <%= (locals.admin.full_name || locals.admin.email || 'A').charAt(0).toUpperCase() %>
              </div>
              <div class="topbar-admin-info">
                <span class="topbar-admin-name"><%= locals.admin.full_name || locals.admin.email %></span>
                <span class="topbar-admin-role"><%= (locals.admin.role || 'admin').replace(/_/g,' ') %></span>
              </div>
            </div>
            <% } %>
          </div>
        </header>

        <!-- Page Content -->
        <main class="page-content">
          <% if (locals.isServiceRoleConfigured === false) { %>
            <div class="rls-warning-banner" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 16px; color: var(--text);">
              <div style="background: #dc2626; color: white; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-weight: 800; font-size: 18px; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.2);">⚠️</div>
              <div style="flex: 1;">
                <h4 style="margin: 0 0 4px 0; font-size: 14.5px; font-weight: 700; color: var(--text);">Restricted Database Key Mode (RLS Active)</h4>
                <p style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.45;">
                  The backend server is running with the public anonymous key (Subject to Row Level Security) because the <strong>SUPABASE_SERVICE_ROLE_KEY</strong> environment variable is missing. Due to RLS policies, public SELECT queries on the <code>users</code> table are filtered, resulting in <strong>0 users</strong> being displayed on the dashboard and users page.
                </p>
                <div style="margin-top: 10px; display: flex; gap: 12px; align-items: center;">
                  <span style="font-size: 11.5px; font-weight: 700; color: #ef4444; text-transform: uppercase; letter-spacing: 0.05em;"><%= locals.isProduction ? 'Action Required: Configure Render' : 'Action Required: Local .env File' %></span>
                  <a href="#diagnostics-help" onclick="alert('How to Fix This:\n\n1. PRODUCTION (Render):\nGo to Render Dashboard -> bharbike-backend -> Environment. Add a new variable:\n- Key: SUPABASE_SERVICE_ROLE_KEY\n- Value: (Your Supabase service_role secret key from Project Settings -> API)\n\n2. LOCAL DEVELOPMENT:\nAdd SUPABASE_SERVICE_ROLE_KEY to your bike rental system backend/.env file and restart the npm server.')" style="font-size: 12.5px; font-weight: 700; color: var(--text); text-decoration: underline;">How to Fix This</a>
                </div>
              </div>
            </div>
          <% } %>
          <%- include(bodyView) %>
        </main>

      </div>
    </div>

    <div id="toast-container" class="toast-container"></div>

    <script>
      (() => {
        // Auth check
        const token = localStorage.getItem("adminToken");
        if (!token) { window.location.href = "/admin/login"; return; }

        // Logout
        const logoutBtn = document.getElementById("admin-logout-btn");
        if (logoutBtn) {
          logoutBtn.addEventListener("click", () => {
            localStorage.removeItem("adminToken");
            document.cookie = "admin_token=; Path=/; Max-Age=0; SameSite=Lax";
            window.location.href = "/admin/login";
          });
        }

        // Dark mode
        const themeToggle = document.getElementById("theme-toggle");
        const iconMoon = document.getElementById("icon-moon");
        const iconSun = document.getElementById("icon-sun");
        const applyTheme = (dark) => {
          document.body.classList.toggle("dark-mode", dark);
          if (iconMoon) iconMoon.style.display = dark ? "none" : "block";
          if (iconSun) iconSun.style.display = dark ? "block" : "none";
        };
        applyTheme(localStorage.getItem("adminTheme") === "dark");
        if (themeToggle) {
          themeToggle.addEventListener("click", () => {
            const isDark = document.body.classList.toggle("dark-mode");
            localStorage.setItem("adminTheme", isDark ? "dark" : "light");
            applyTheme(isDark);
          });
        }

        // Mobile sidebar
        const menuBtn = document.getElementById("sidebar-menu-btn");
        const sidebar = document.getElementById("admin-sidebar");
        if (menuBtn && sidebar) {
          menuBtn.addEventListener("click", () => sidebar.classList.toggle("open"));
        }

        // Sidebar collapse (desktop)
        const collapseBtn = document.getElementById("sidebar-collapse-btn");
        const shell = document.querySelector(".admin-shell");
        const applyCollapse = (collapsed) => {
          if (sidebar) sidebar.classList.toggle("sidebar-collapsed", collapsed);
          if (shell) shell.classList.toggle("sidebar-is-collapsed", collapsed);
          const arrow = collapseBtn ? collapseBtn.querySelector(".toggle-arrow") : null;
          if (arrow) arrow.style.transform = collapsed ? "rotate(180deg)" : "rotate(0deg)";
          if (collapseBtn) collapseBtn.title = collapsed ? "Expand sidebar" : "Collapse sidebar";
        };
        const savedCollapse = localStorage.getItem("adminSidebarCollapsed") === "true";
        applyCollapse(savedCollapse);
        if (collapseBtn) {
          collapseBtn.addEventListener("click", () => {
            const next = !sidebar.classList.contains("sidebar-collapsed");
            applyCollapse(next);
            localStorage.setItem("adminSidebarCollapsed", next ? "true" : "false");
        }

        // ─── Topbar Notifications Dropdown Logic ───
        const notifBtn = document.getElementById("notif-bell-btn");
        const notifPanel = document.getElementById("notif-dropdown-panel");
        const notifList = document.getElementById("notif-dropdown-list");
        const notifBadge = document.getElementById("notif-badge");

        if (notifBtn && notifPanel && notifList) {
          // Helper to calculate time ago
          const timeAgo = (dateString) => {
            const date = new Date(dateString);
            const seconds = Math.floor((new Date() - date) / 1000);
            if (seconds < 60) return "just now";
            const minutes = Math.floor(seconds / 60);
            if (minutes < 60) return `${minutes}m ago`;
            const hours = Math.floor(minutes / 60);
            if (hours < 24) return `${hours}h ago`;
            const days = Math.floor(hours / 24);
            return `${days}d ago`;
          };

          // Helper to map log types to icons/colors
          const getLogIcon = (type) => {
            switch (type) {
              case "order": return { char: "🚲", bg: "rgba(99, 102, 241, 0.15)", color: "#6366f1" };
              case "booking": return { char: "🔑", bg: "rgba(16, 185, 129, 0.15)", color: "#10b981" };
              case "payment": return { char: "💰", bg: "rgba(245, 158, 11, 0.15)", color: "#f59e0b" };
              case "kyc": return { char: "🛡️", bg: "rgba(239, 68, 68, 0.15)", color: "#ef4444" };
              case "subscription": return { char: "⚡", bg: "rgba(139, 92, 246, 0.15)", color: "#8b5cf6" };
              default: return { char: "🔔", bg: "rgba(156, 163, 175, 0.15)", color: "#9ca3af" };
            }
          };

          const escapeHtml = (str) => {
            if (!str) return "";
            return String(str)
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;")
              .replace(/'/g, "&#039;");
          };

          let loadedLogs = [];

          // Render list function
          const renderList = () => {
            if (loadedLogs.length === 0) {
              notifList.innerHTML = `<div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 12px;">No recent activities</div>`;
              return;
            }

            notifList.innerHTML = loadedLogs.map(log => {
              const icon = getLogIcon(log.type);
              return `
                <div class="notif-dropdown-item">
                  <div class="notif-item-icon" style="background:${icon.bg}; color:${icon.color};">
                    ${icon.char}
                  </div>
                  <div class="notif-item-content">
                    <div class="notif-item-title">${escapeHtml(log.user_name)}: ${escapeHtml(log.action)}</div>
                    <div class="notif-item-details">${escapeHtml(log.details)}</div>
                    <div class="notif-item-time">${timeAgo(log.timestamp)}</div>
                  </div>
                </div>
              `;
            }).join("");
          };

          // Fetch notifications function
          const fetchActivities = async () => {
            try {
              const response = await fetch("/admin/activity-logs?ajax=true");
              if (!response.ok) throw new Error("Fetch failed");
              const data = await response.json();
              if (data && data.success && Array.isArray(data.logs)) {
                loadedLogs = data.logs.slice(0, 6);
                renderList();
                // Optional: Show badge if there is new activity compared to last time
                if (loadedLogs.length > 0) {
                  notifBadge.style.display = "block";
                }
              }
            } catch (err) {
              console.warn("Topbar notifications fetch failed:", err);
            }
          };

          // Open/Close dropdown
          notifBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const isVisible = notifPanel.style.display === "block";
            if (isVisible) {
              notifPanel.style.display = "none";
            } else {
              notifPanel.style.display = "block";
              notifBadge.style.display = "none"; // Clear badge when opened
              fetchActivities();
            }
          });

          // Close when clicking outside
          document.addEventListener("click", (e) => {
            if (!notifPanel.contains(e.target) && !notifBtn.contains(e.target)) {
              notifPanel.style.display = "none";
            }
          });

          // Initial check for activities to toggle red dot
          fetchActivities();
          
          // Poll every 60 seconds
          setInterval(fetchActivities, 60000);
        }
      })();
    </script>
    <script src="/admin/static/js/sidebar-nav.js?v=3"></script>
    <script src="/admin/static/js/admin.js?v=3"></script>
  </body>
</html>
