<!-- CLIENT-SIDE SCRIPT FOR JOB CARD WORKFLOW   -->
<!-- ========================================== -->
<script>
  // Server-injected data
  const PARTS_CATALOG = <%- JSON.stringify(partsCatalog || []) %>;
  const BIKE_RIDER_MAP = <%- JSON.stringify(bikeRiderMap || {}) %>;

  // Selected components state: Map of key -> item object
  let selectedComponents = [];

  // Initialize
  document.addEventListener("DOMContentLoaded", () => {
    // Populate catalogs
    renderCatalog('bike');
    renderCatalog('led_box');

    // Auto-detect rider on bike select
    const bikeSelect = document.getElementById("jc-bike-select");
    if (bikeSelect) {
      bikeSelect.addEventListener("change", () => {
        const bikeId = bikeSelect.value;
        const riderInput = document.getElementById("jc-rider-name");
        if (bikeId && BIKE_RIDER_MAP[bikeId]) {
          riderInput.value = BIKE_RIDER_MAP[bikeId].riderName || "";
        } else {
          riderInput.value = "";
        }
      });
    }

    // Default start time to now
    const startTimeInput = document.getElementById("jc-start-time");
    if (startTimeInput) {
      const now = new Date();
      now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
      startTimeInput.value = now.toISOString().slice(0, 16);
    }

    // Open Job Card modal button
    const openBtn = document.getElementById("btn-open-job-card-modal");
    if (openBtn) {
      openBtn.addEventListener("click", () => {
        // Reset form & cart
        selectedComponents = [];
        renderSelectedComponents();
        document.getElementById("job-card-form").reset();
        document.getElementById("jc-preview-number").innerText = "JC-" + new Date().getFullYear() + String(new Date().getMonth() + 1).padStart(2, '0') + "-AUTO";
        switchJcTab('bike');
        updatePaymentSummary();
        openModal("new-job-card-modal");
      });
    }

    // Modal close buttons
    document.querySelectorAll(".close-modal-btn").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const modal = e.target.closest(".modal");
        if (modal) modal.style.display = "none";
      });
    });

    // Close when clicking modal backdrop
    document.querySelectorAll(".modal").forEach(modal => {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.style.display = "none";
      });
    });

    // Wire Job Card Form Submission
    const jcForm = document.getElementById("job-card-form");
    if (jcForm) {
      jcForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("btn-submit-job-card");
        submitBtn.disabled = true;
        submitBtn.innerText = "Creating...";

        try {
          const bikeId = document.getElementById("jc-bike-select").value;
          const riderName = document.getElementById("jc-rider-name").value;
          const techName = document.getElementById("jc-tech-name").value;
          const shift = document.getElementById("jc-shift").value;
          const serviceType = document.getElementById("jc-service-type").value;
          const startTime = document.getElementById("jc-start-time").value;

          const boxNumber = document.getElementById("jc-box-number").value;
          const deliveryStatus = document.getElementById("jc-delivery-status").value;
          const boxService = document.querySelector("input[name='boxService']:checked")?.value === "yes";
          const ledService = document.querySelector("input[name='ledService']:checked")?.value === "yes";
          const boxReason = document.getElementById("jc-box-reason").value;

          const paymentOption = document.querySelector("input[name='paymentOption']:checked")?.value;
          const paymentMethod = document.getElementById("jc-pay-method").value;
          const amountCollected = Number(document.getElementById("jc-pay-amount").value || 0);
          const paymentRef = document.getElementById("jc-pay-ref").value;

          const payload = {
            bikeId,
            riderName,
            technicianName: techName,
            shift,
            serviceType,
            startTime,
            boxNumber,
            deliveryStatus,
            boxService,
            ledService,
            boxServiceReason: boxReason,
            components: selectedComponents
          };

          const res = await fetch("/admin/maintenance/job-card/create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          const json = await res.json();
          if (!json.success) throw new Error(json.message);

          const ticketId = json.data.id;

          // If payment was received right at creation time, close it immediately
          if (paymentOption === "received") {
            await fetch(`/admin/maintenance/job-card/${ticketId}/close`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                hasRiderPaid: "yes",
                paymentMethod,
                amountCollected,
                paymentRef
              })
            });
          }

          alert("Job Card created successfully!");
          window.location.reload();
        } catch (err) {
          alert("Error creating job card: " + err.message);
          submitBtn.disabled = false;
          submitBtn.innerText = "Create Job Card";
        }
      });
    }

    // Wire Quick Collect Payment buttons in table
    document.querySelectorAll(".open-collect-payment").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.id;
        document.getElementById("collect-ticket-id").value = id;
        document.getElementById("collect-job-card").innerText = btn.dataset.jobCard || id;
        document.getElementById("collect-bike").innerText = btn.dataset.bike || "Bike";
        document.getElementById("collect-rider").innerText = btn.dataset.rider || "Rider";
        document.getElementById("collect-amount-due").innerText = "₹" + btn.dataset.amount;
        document.getElementById("collect-amount-input").value = btn.dataset.amount;
        openModal("collect-payment-modal");
      });
    });

    // Wire Collect Payment Form submission
    const collectForm = document.getElementById("collect-payment-form");
    if (collectForm) {
      collectForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = document.getElementById("collect-ticket-id").value;
        const method = document.getElementById("collect-method").value;
        const amountCollected = document.getElementById("collect-amount-input").value;
        const paymentRef = document.getElementById("collect-ref-input").value;

        try {
          const res = await fetch(`/admin/maintenance/job-card/${id}/record-payment`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ paymentMethod: method, amountCollected, paymentRef })
          });
          const json = await res.json();
          if (!json.success) throw new Error(json.message);
          alert(json.message);
          window.location.reload();
        } catch (err) {
          alert("Error: " + err.message);
        }
      });
    }

    // Wire Close Ticket buttons in table
    document.querySelectorAll(".open-close-ticket").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.id;
        const riderAmt = Number(btn.dataset.riderAmt || 0);
        const coAmt = Number(btn.dataset.coAmt || 0);
        document.getElementById("close-ticket-id").value = id;
        document.getElementById("close-job-card").innerText = btn.dataset.jobCard || id;
        document.getElementById("close-bike").innerText = btn.dataset.bike || "Bike";
        document.getElementById("close-rider").innerText = btn.dataset.rider || "Rider";
        document.getElementById("close-rider-amt").innerText = "₹" + riderAmt;
        document.getElementById("close-co-amt").innerText = "₹" + coAmt;
        document.getElementById("close-pay-amount").value = riderAmt;

        if (riderAmt === 0) {
          document.getElementById("close-opt-na").checked = true;
        } else {
          document.getElementById("close-opt-no").checked = true;
        }
        onCloseOptChange();
        openModal("close-ticket-modal");
      });
    });

    // Wire Close Ticket Form submission
    const closeForm = document.getElementById("close-ticket-form");
    if (closeForm) {
      closeForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = document.getElementById("close-ticket-id").value;
        const opt = document.querySelector("input[name='closePaymentOpt']:checked")?.value;
        const method = document.getElementById("close-pay-method").value;
        const amountCollected = document.getElementById("close-pay-amount").value;
        const paymentRef = document.getElementById("close-pay-ref").value;

        try {
          const res = await fetch(`/admin/maintenance/job-card/${id}/close`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              hasRiderPaid: opt,
              paymentMethod: method,
              amountCollected,
              paymentRef
            })
          });
          const json = await res.json();
          if (!json.success) throw new Error(json.message);
          alert(json.message);
          window.location.reload();
        } catch (err) {
          alert("Error: " + err.message);
        }
      });
    }

  });

  // Helper to open modal
  function openModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.style.display = "flex";
  }

  // Switch tabs between Bike Parts and LED Box
  function switchJcTab(tab) {
    const bikePane = document.getElementById("jc-pane-bike-parts");
    const ledPane = document.getElementById("jc-pane-led-box");
    const bikeBtn = document.getElementById("tab-btn-bike-parts");
    const ledBtn = document.getElementById("tab-btn-led-box");

    if (tab === 'bike') {
      bikePane.style.display = "block";
      ledPane.style.display = "none";
      bikeBtn.classList.add("active");
      ledBtn.classList.remove("active");
    } else {
      bikePane.style.display = "none";
      ledPane.style.display = "block";
      ledBtn.classList.add("active");
      bikeBtn.classList.remove("active");
    }
  }

  // Render parts catalog into grid
  function renderCatalog(category) {
    const listEl = document.getElementById(category === 'bike' ? 'bike-parts-catalog-list' : 'led-parts-catalog-list');
    if (!listEl) return;
    const parts = PARTS_CATALOG.filter(p => p.category === category);
    listEl.innerHTML = "";

    parts.forEach(part => {
      const div = document.createElement("div");
      div.className = "catalog-item";
      div.setAttribute("data-name", part.name.toLowerCase());
      div.innerHTML = `
        <div class="item-info">
          <span class="item-name">${part.name}</span>
          <span class="item-price">₹${part.default_price || 0}</span>
        </div>
        <button type="button" class="btn btn-ghost" style="padding: 4px 10px; font-size: 11px; font-weight: 600;" onclick="addComponent('${part.category}', '${part.name}', ${part.default_price || 0})">+ Add</button>
      `;
      listEl.appendChild(div);
    });
  }

  // Filter parts search
  function filterParts(category) {
    const query = document.getElementById(category === 'bike' ? 'bike-parts-search' : 'led-parts-search').value.toLowerCase();
    const listEl = document.getElementById(category === 'bike' ? 'bike-parts-catalog-list' : 'led-parts-catalog-list');
    const items = listEl.querySelectorAll(".catalog-item");
    items.forEach(it => {
      const name = it.getAttribute("data-name") || "";
      it.style.display = name.includes(query) ? "flex" : "none";
    });
  }

  // Add component to selection
  function addComponent(category, name, unitPrice) {
    const existing = selectedComponents.find(c => c.category === category && c.component_name === name);
    if (existing) {
      existing.quantity += 1;
    } else {
      selectedComponents.push({
        category,
        component_name: name,
        unit_price: unitPrice,
        quantity: 1,
        charge_to: "rider" // Default to rider as in client mockup
      });
    }
    renderSelectedComponents();
    updatePaymentSummary();
  }

  // Change quantity with steppers
  function updateQty(idx, delta) {
    if (!selectedComponents[idx]) return;
    selectedComponents[idx].quantity += delta;
    if (selectedComponents[idx].quantity <= 0) {
      selectedComponents.splice(idx, 1);
    }
    renderSelectedComponents();
    updatePaymentSummary();
  }

  // Change charge allocation (company vs rider)
  function updateChargeTo(idx, val) {
    if (!selectedComponents[idx]) return;
    selectedComponents[idx].charge_to = val;
    updatePaymentSummary();
  }

  // Remove component from selection
  function removeComponent(idx) {
    selectedComponents.splice(idx, 1);
    renderSelectedComponents();
    updatePaymentSummary();
  }

  // Render selected components list matching mockups
  function renderSelectedComponents() {
    const bikeWrap = document.getElementById("bike-selected-wrap");
    const ledWrap = document.getElementById("led-selected-wrap");

    const bikeItems = selectedComponents.map((c, i) => ({ ...c, originalIndex: i })).filter(c => c.category === 'bike');
    const ledItems = selectedComponents.map((c, i) => ({ ...c, originalIndex: i })).filter(c => c.category === 'led_box');

    document.getElementById("bike-selected-count").innerText = bikeItems.length;
    document.getElementById("led-selected-count").innerText = ledItems.length;

    renderItemCards(bikeWrap, bikeItems, "No bike components selected.");
    renderItemCards(ledWrap, ledItems, "No LED box components selected.");
  }

  function renderItemCards(wrapEl, items, emptyText) {
    if (!wrapEl) return;
    if (items.length === 0) {
      wrapEl.innerHTML = `<div style="color: var(--text-muted); font-size: 12px; text-align: center; padding: 12px;">${emptyText}</div>`;
      return;
    }

    wrapEl.innerHTML = "";
    items.forEach(item => {
      const idx = item.originalIndex;
      const card = document.createElement("div");
      card.className = "selected-item-card";
      card.innerHTML = `
        <div class="selected-item-header">
          <div>
            <div class="selected-item-name">${item.component_name}</div>
            <div style="font-size: 11px; color: var(--text-muted);">Quantity: ${item.quantity} × ₹${item.unit_price} = ₹${item.quantity * item.unit_price}</div>
          </div>
          <div class="qty-stepper">
            <button type="button" onclick="updateQty(${idx}, -1)">-</button>
            <span>${item.quantity}</span>
            <button type="button" onclick="updateQty(${idx}, 1)">+</button>
          </div>
        </div>

        <div style="font-size: 11px; color: var(--text-muted); font-weight: 600;">Charge to:</div>
        <div class="charge-radio-group">
          <label>
            <input type="radio" name="charge_${idx}" value="company" ${item.charge_to === 'company' ? 'checked' : ''} onchange="updateChargeTo(${idx}, 'company')">
            Company
          </label>
          <label>
            <input type="radio" name="charge_${idx}" value="rider" ${item.charge_to === 'rider' ? 'checked' : ''} onchange="updateChargeTo(${idx}, 'rider')">
            Rider
          </label>
        </div>

        <button type="button" class="btn-remove-item" onclick="removeComponent(${idx})">Remove component</button>
      `;
      wrapEl.appendChild(card);
    });
  }

  // Update total calculation and payment summary
  function updatePaymentSummary() {
    let companyAmt = 0;
    let riderAmt = 0;

    selectedComponents.forEach(c => {
      const total = Number(c.quantity || 1) * Number(c.unit_price || 0);
      if (c.charge_to === 'rider') {
        riderAmt += total;
      } else {
        companyAmt += total;
      }
    });

    document.getElementById("summary-co-amt").innerText = `₹${companyAmt}`;
    document.getElementById("summary-rider-amt").innerText = `₹${riderAmt}`;
    document.getElementById("summary-total-amt").innerText = `₹${companyAmt + riderAmt}`;

    // Auto-update radio options based on rider liability
    const optReceived = document.getElementById("opt-payment-received");
    const optPending = document.getElementById("opt-payment-pending");
    const optNa = document.getElementById("opt-payment-na");

    if (riderAmt === 0 && selectedComponents.length > 0) {
      optNa.checked = true;
    } else if (riderAmt > 0 && optNa.checked) {
      optPending.checked = true;
    }

    const payAmtInput = document.getElementById("jc-pay-amount");
    if (payAmtInput && (!payAmtInput.value || Number(payAmtInput.value) === 0)) {
      payAmtInput.value = riderAmt;
    }

    onPaymentOptionChange();
  }

  // Payment option change in Job Card modal
  function onPaymentOptionChange() {
    const opt = document.querySelector("input[name='paymentOption']:checked")?.value;
    const detailsGroup = document.getElementById("payment-details-group");
    const badge = document.getElementById("jc-status-badge");

    if (opt === 'received') {
      detailsGroup.style.display = "block";
      badge.className = "jc-pill-badge jc-badge-completed";
      badge.innerText = "Completed";
    } else if (opt === 'pending') {
      detailsGroup.style.display = "none";
      badge.className = "jc-pill-badge jc-badge-pending";
      badge.innerText = "Payment Pending";
    } else {
      detailsGroup.style.display = "none";
      badge.className = "jc-pill-badge jc-badge-repair";
      badge.innerText = "Under Repair (Company Paid)";
    }
  }

  // Payment option change in Close Ticket modal
  function onCloseOptChange() {
    const opt = document.querySelector("input[name='closePaymentOpt']:checked")?.value;
    const fields = document.getElementById("close-payment-fields");
    if (opt === 'yes') {
      fields.style.display = "block";
    } else {
      fields.style.display = "none";
    }
  }
</script>
