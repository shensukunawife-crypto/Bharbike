    padding: 8px 12px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }
  .jc-tab-btn.active {
    background: var(--gold, #D4AF37);
    color: #000;
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.3);
  }

  .jc-section-title {
