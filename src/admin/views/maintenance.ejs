  </div>
  <div class="page-stat page-stat-accent">
    <p class="page-stat-label">⌛ In Progress</p>
    <p class="page-stat-value"><%= maintenanceStats?.inProgress || 0 %></p>
  </div>
  <div class="page-stat" style="border-left: 3px solid #f59e0b;">
    <p class="page-stat-label" style="color: #f59e0b;">⚠️ Payment Pending</p>
    <p class="page-stat-value" style="color: #f59e0b;"><%= maintenanceStats?.paymentPending || 0 %></p>
  </div>
  <div class="page-stat">
    <p class="page-stat-label">✅ Completed</p>
    <p class="page-stat-value"><%= maintenanceStats?.completed || 0 %></p>
  </div>
  <div class="page-stat">
    <p class="page-stat-label">💰 Total Repair Cost</p>
    <p class="page-stat-value">₹<%= Number(maintenanceStats?.totalCost || 0).toLocaleString('en-IN') %></p>
  </div>
  <div class="page-stat">
    <p class="page-stat-label">👤 Rider Liability</p>
    <p class="page-stat-value">₹<%= Number(maintenanceStats?.totalRiderCost || 0).toLocaleString('en-IN') %></p>
  </div>
</div>

<div class="toolbar">
  <button class="btn btn-gold glow" id="btn-open-job-card-modal">+ Open Maintenance Job Card</button>
  <a class="btn <%= filter === 'all' ? 'btn-gold' : 'btn-ghost' %>" href="/admin/maintenance?filter=all">All</a>
  <a class="btn <%= filter === 'active' ? 'btn-gold' : 'btn-ghost' %>" href="/admin/maintenance?filter=active">Active</a>
  <a class="btn <%= filter === 'payment_pending' ? 'btn-gold' : 'btn-ghost' %>" href="/admin/maintenance?filter=payment_pending">Payment Pending (<%= maintenanceStats?.paymentPending || 0 %>)</a>
  <a class="btn <%= filter === 'completed' ? 'btn-gold' : 'btn-ghost' %>" href="/admin/maintenance?filter=completed">Completed</a>
  <form method="GET" action="/admin/maintenance" class="inline-form">
    <input type="hidden" name="filter" value="<%= filter %>" />
    <input class="filter-input" type="text" name="search" value="<%= search || '' %>" placeholder="Search Bike ID, Job Card #, Rider" />
    <button class="btn btn-ghost" type="submit">Search</button>
  </form>
</div>

<!-- Active Tickets Table -->
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Job Card #</th>
        <th>Bike ID</th>
        <th>Rider / Driver</th>
        <th>Shift & Service</th>
        <th>Components Used</th>
        <th>Cost (Company / Rider)</th>
        <th>Status</th>
        <th>Payment Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!tickets.length) { %>
      <tr><td colspan="9" class="empty">No maintenance tickets found</td></tr>
      <% } %>
      <% tickets.forEach((ticket, idx) => { %>
      <tr class="<%= idx % 2 ? 'zebra' : '' %>">
        <td>
          <span style="font-weight: 700; color: var(--gold);"><%= ticket.jobCardNumber || ticket.ticketId %></span>
          <br>
          <span style="font-size: 11px; color: var(--text-muted);"><%= ticket.reportedDate ? ticket.reportedDate.slice(0, 10) : '' %></span>
        </td>
        <td>
          <strong>🛵 <%= ticket.bikeCode %></strong>
        </td>
        <td>
          <span style="font-weight: 600;"><%= ticket.riderName && ticket.riderName !== 'Unassigned' ? ticket.riderName : '—' %></span>
        </td>
        <td>
          <span class="badge badge-soft" style="text-transform: capitalize;"><%= ticket.shift || 'morning' %></span>
          <br>
          <span style="font-size: 11px; color: var(--text-muted); text-transform: capitalize;"><%= (ticket.serviceType || 'repair').replace('_', ' ') %></span>
        </td>
        <td>
          <% if (ticket.components && ticket.components.length > 0) { %>
            <span class="badge badge-soft" title="<%= ticket.components.map(c => c.component_name + ' (x' + c.quantity + ')').join(', ') %>">
              📦 <%= ticket.components.length %> parts
            </span>
            <div style="font-size: 11px; color: var(--text-muted); max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              <%= ticket.components.map(c => c.component_name).join(', ') %>
            </div>
          <% } else { %>
            <span style="color: var(--text-muted); font-size: 12px;">—</span>
          <% } %>
        </td>
        <td>
          <strong>₹<%= ticket.repairCost %></strong>
          <br>
          <span style="font-size: 11px; color: #10b981;">Co: ₹<%= ticket.companyAmount || 0 %></span> | 
          <span style="font-size: 11px; color: #f59e0b;">Rider: ₹<%= ticket.riderAmount || 0 %></span>
        </td>
        <td>
          <% if (ticket.status === 'payment_pending') { %>
            <span class="jc-pill-badge jc-badge-pending">⚠️ Payment Pending</span>
          <% } else if (ticket.status === 'completed') { %>
            <span class="jc-pill-badge jc-badge-completed">✅ Completed</span>
          <% } else { %>
            <span class="jc-pill-badge jc-badge-repair">🔧 Under Repair</span>
          <% } %>
        </td>
        <td>
          <% if (ticket.paymentStatus === 'paid') { %>
            <span class="badge success">Paid (<%= (ticket.paymentMethod || 'cash').toUpperCase() %>)</span>
          <% } else if (ticket.paymentStatus === 'payment_pending') { %>
            <span class="badge warning">Pending ₹<%= ticket.riderAmount || 0 %></span>
          <% } else { %>
            <span class="badge badge-soft">Company Paid</span>
          <% } %>
        </td>
        <td class="actions">
          <% if (ticket.status === 'payment_pending') { %>
            <button 
              class="btn btn-warning open-collect-payment" 
              data-id="<%= ticket.id %>"
              data-job-card="<%= ticket.jobCardNumber || ticket.ticketId %>"
              data-bike="<%= ticket.bikeCode %>"
              data-rider="<%= ticket.riderName || 'Rider' %>"
              data-amount="<%= ticket.riderAmount || 0 %>"
            >
              💳 Collect
            </button>
          <% } else if (ticket.status !== 'completed') { %>
            <button 
              class="btn btn-success open-close-ticket" 
              data-id="<%= ticket.id %>"
              data-job-card="<%= ticket.jobCardNumber || ticket.ticketId %>"
              data-bike="<%= ticket.bikeCode %>"
              data-rider="<%= ticket.riderName || 'Rider' %>"
              data-rider-amt="<%= ticket.riderAmount || 0 %>"
              data-co-amt="<%= ticket.companyAmount || 0 %>"
            >
              🔧 Close
            </button>
          <% } %>
          <button
            class="btn btn-outline open-maintenance-status"
            data-id="<%= ticket.id %>"
            data-bike-code="<%= ticket.bikeCode %>"
            data-issue-type="<%= ticket.issueType %>"
            data-description="<%= ticket.description %>"
            data-status="<%= ticket.status %>"
            data-tech="<%= ticket.technicianName %>"
            data-cost="<%= ticket.repairCost %>"
            data-work-details="<%= ticket.workDetails || '' %>"
            data-reported-date="<%= ticket.reportedDate || '' %>"
            data-expected="<%= ticket.expectedFixDate || '' %>"
            data-fixed-date="<%= ticket.fixedDate || '' %>"
          >
            🔍 Details
          </button>
          <button class="btn btn-danger-ghost admin-action" data-url="/admin/maintenance/<%= ticket.id %>/remove" data-method="POST" data-confirm="Delete this maintenance record?">🗑️</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Maintenance History Table -->
<div class="chart-card">
  <h3>Maintenance History</h3>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Job Card #</th>
          <th>Bike ID</th>
          <th>Rider</th>
          <th>Service / Issue</th>
          <th>Cost Breakdown</th>
          <th>Payment</th>
          <th>Time In</th>
          <th>Time Out</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!history.length) { %>
        <tr><td colspan="9" class="empty">No completed maintenance history found</td></tr>
        <% } %>
        <% history.forEach((item) => { %>
        <tr>
          <td><strong style="color:var(--gold);"><%= item.jobCardNumber || item.ticketId %></strong></td>
          <td>🛵 <%= item.bikeCode %></td>
          <td><%= item.riderName && item.riderName !== 'Unassigned' ? item.riderName : '—' %></td>
          <td><span class="badge badge-soft"><%= item.issueType %></span></td>
          <td>
            <strong>₹<%= item.repairCost %></strong>
            <br>
            <span style="font-size:11px; color:#10b981;">Co: ₹<%= item.companyAmount || 0 %></span> | 
            <span style="font-size:11px; color:#f59e0b;">Rider: ₹<%= item.riderAmount || 0 %></span>
          </td>
          <td>
            <% if (item.paymentStatus === 'paid') { %>
              <span class="badge success">Paid (<%= (item.paymentMethod || 'cash').toUpperCase() %>)</span>
            <% } else { %>
              <span class="badge badge-soft">Company Paid</span>
            <% } %>
          </td>
          <td><%= item.reportedDate || '-' %></td>
          <td><%= item.fixedDate || '-' %></td>
          <td class="actions">
            <button
              class="btn btn-outline open-maintenance-status"
              data-id="<%= item.id %>"
              data-bike-code="<%= item.bikeCode %>"
              data-issue-type="<%= item.issueType %>"
              data-description="<%= item.description %>"
              data-status="<%= item.status %>"
              data-tech="<%= item.technicianName %>"
              data-cost="<%= item.repairCost %>"
              data-work-details="<%= item.workDetails || '' %>"
              data-reported-date="<%= item.reportedDate || '' %>"
              data-expected="<%= item.expectedFixDate || '' %>"
              data-fixed-date="<%= item.fixedDate || '' %>"
            >
              🔍 Details
            </button>
            <button class="btn btn-danger-ghost admin-action" data-url="/admin/maintenance/<%= item.id %>/remove" data-method="POST" data-confirm="Are you sure you want to delete this historical maintenance record?">🗑️ Delete</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- User Support Requests -->
<div class="chart-card">
  <h3>User Support Requests</h3>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Ticket ID</th>
          <th>Issue Type</th>
          <th>Description</th>
          <th>Status</th>
          <th>Created At</th>
        </tr>
      </thead>
      <tbody id="maintenance-support-body">
        <% if (!(supportTickets || []).length) { %>
        <tr><td colspan="5" class="empty">No support tickets found</td></tr>
        <% } %>
        <% (supportTickets || []).forEach((ticket, idx) => { %>
        <tr>
          <td><% if (ticket.ticket_number != null && ticket.ticket_number !== undefined) { %>#<%= ticket.ticket_number %><% } else { %>—<% } %> <button class="btn btn-ghost copy-ticket-id" data-value="<%= (ticket.ticket_number != null && ticket.ticket_number !== undefined) ? ticket.ticket_number : '' %>">📋</button></td>
          <td><span class="badge badge-soft"><%= ticket.issue_type || '-' %></span></td>
          <td title="<%= ticket.description || '' %>"><%= String(ticket.description || '-').slice(0, 60) %><%= String(ticket.description || '').length > 60 ? '...' : '' %></td>
          <td>
            <span class="badge <%= ticket.status === 'resolved' ? 'success' : ticket.status === 'in_progress' ? 'warning' : 'danger' %>">
              <%= ticket.status === 'in_progress' ? 'In Progress' : ticket.status === 'resolved' ? 'Resolved' : 'Pending' %>
            </span>
          </td>
          <td><%= formatToIST12Hr(ticket.created_at) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: NEW JOB CARD (MATCHING WIREFRAME) -->
<!-- ========================================== -->
<div class="modal" id="new-job-card-modal">
  <div class="modal-content" style="max-width: 600px; width: 95%; max-height: 90vh; display: flex; flex-direction: column;">
    <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 14px 20px; display: flex; align-items: center; justify-content: space-between;">
      <div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <h3 style="margin: 0; font-size: 18px;">Maintenance Ticket</h3>
          <span class="badge badge-soft" style="font-size: 11px;">Draft</span>
        </div>
        <div style="font-size: 12px; color: var(--gold); margin-top: 2px;">
          Job Card # — <span id="jc-preview-number">Auto-generated</span>
        </div>
      </div>
      <button type="button" class="close-modal-btn" style="background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-muted);">&times;</button>
    </div>

    <form id="job-card-form" style="display: flex; flex-direction: column; flex: 1; overflow: hidden; margin: 0;">
      <div style="overflow-y: auto; padding: 20px; flex: 1;">

        <!-- Step 1: Core Ticket Details -->
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin-bottom: 16px;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 600;">Bike Number *</label>
              <select name="bikeId" id="jc-bike-select" required style="width: 100%; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);">
                <option value="">-- Select Bike --</option>
                <% bikes.forEach((b) => { %>
                  <option value="<%= b.id %>" data-bike-code="<%= b.bike_code %>"><%= b.bike_code %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 600;">Rider / Driver Name</label>
              <input type="text" name="riderName" id="jc-rider-name" placeholder="Auto-detected on bike select" style="width: 100%; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);" />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px;">
            <div>
              <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 600;">Technician Name *</label>
              <input type="text" name="technicianName" id="jc-tech-name" placeholder="Technician name" required style="width: 100%; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);" />
            </div>
            <div>
              <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 600;">Shift *</label>
              <select name="shift" id="jc-shift" style="width: 100%; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);">
                <option value="morning">Morning Shift</option>
                <option value="evening">Evening Shift</option>
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px;">
            <div>
              <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 600;">Service Type *</label>
              <select name="serviceType" id="jc-service-type" style="width: 100%; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);">
                <option value="regular_service">Regular Service</option>
                <option value="repair" selected>Repair</option>
              </select>
            </div>
            <div>
              <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 4px; font-weight: 600;">Start Time</label>
              <input type="datetime-local" name="startTime" id="jc-start-time" style="width: 100%; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text);" />
            </div>
          </div>
        </div>

        <!-- Tab Switcher: [ Bike Parts ] vs [ LED Box ] -->
        <div class="jc-tab-nav">
          <button type="button" class="jc-tab-btn active" id="tab-btn-bike-parts" onclick="switchJcTab('bike')">Bike Parts</button>
          <button type="button" class="jc-tab-btn" id="tab-btn-led-box" onclick="switchJcTab('led_box')">LED Box</button>
        </div>

        <!-- TAB 1: BIKE PARTS -->
        <div id="jc-pane-bike-parts">
          <div class="catalog-search-wrap">
            <input type="text" id="bike-parts-search" placeholder="🔍 Search component list..." onkeyup="filterParts('bike')" style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); background: var(--bg); color: var(--text);" />
          </div>

          <div class="jc-section-title">Component List</div>
          <div class="catalog-list" id="bike-parts-catalog-list">
            <!-- Populated via JS from partsCatalog -->
